# ==============================================================================
# TSK One IT - Email Notification Configuration
# ==============================================================================

# Destination email where lead notifications will be sent
CONTACT_RECEIVER_EMAIL=info@tskoneit.com

# SMTP Server Settings (Example: Gmail, Zoho, Brevo, Outlook, etc.)
# For Gmail: Use 'smtp.gmail.com', port 465, and create a 16-character App Password at:
# https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-16-character-app-password
SMTP_FROM="TSK One IT Lead Desk" <your-email@gmail.com>
